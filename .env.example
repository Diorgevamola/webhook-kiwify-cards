# ---------- servidor ----------
PORT=3000
# URL pública do serviço. Hoje o subdomínio do EasyPanel; quando tiver domínio
# próprio, troque só esta linha.
PUBLIC_URL=https://webhook-cards-portal-dpa.bacjno.easypanel.host
# Diretório persistente (monte um volume nele no EasyPanel)
DATA_DIR=/data

# ---------- AbacatePay ----------
# Secret definido por você ao criar o webhook no painel da AbacatePay.
# A AbacatePay o envia de volta na query string (?webhookSecret=...).
ABACATEPAY_WEBHOOK_SECRET=
# Deixe true. Use false só no primeiro teste, para ver nos logs o formato real
# que a AbacatePay envia, e volte para true em seguida.
ABACATEPAY_STRICT_SIGNATURE=true
# Opcional: processa só este produto (deixe vazio para aceitar todos)
ABACATEPAY_PRODUCT_ID=prod_QdUSrm302upUgDxSCEqjr6zh

# ---------- SMTP ----------
SMTP_HOST=
SMTP_PORT=587
# true apenas para porta 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=300 Cards de Segurança Familiar
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=
# Cópia oculta para acompanhar as entregas (opcional)
MAIL_BCC=

# ---------- entrega ----------
# Link da pasta do Google Drive com o PDF do produto
DELIVERY_URL=
# Link do complemento Plano Impresso Pronto (opcional)
DELIVERY_BONUS_URL=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
